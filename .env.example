# ─── DATABASE (Supabase) ──────────────────
DATABASE_URL=postgresql://user:password@host:5432/db?pgbouncer=true

# Atau gunakan parameter individual:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=skd_academy
# DB_USER=postgres
# DB_PASSWORD=isi_password

# ─── JWT SECRET ──────────────────────────
JWT_SECRET=ganti_dengan_secret_produksi

# ─── SERVER ──────────────────────────────
PORT=3000

# ─── FRONTEND URL ────────────────────────
FRONTEND_URL=https://skd-academy.my.id

# ─── SMTP (Email) — untuk fitur lupa password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=email@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# ─── Midtrans Payment Gateway ────────────────
# MIDTRANS_SERVER_KEY=Mid-server-xxxx-xxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxx-xxxxxxxx
# MIDTRANS_IS_PRODUCTION=true
